        {
          "name": "Update Care Plan",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"medicines\": [\n        {\n            \"medicineName\": \"Amoxicillin\",\n            \"dosage\": \"500mg\",\n            \"frequency\": \"Three times daily\",\n            \"durationDays\": 10,\n            \"instructions\": \"After meals\"\n        }\n    ],\n    \"allergies\": [\"Penicillin\"],\n    \"consultationNotes\": \"Updated: patient responded well, extending antibiotics to 10 days.\",\n    \"preVisitServices\": [\n        {\n            \"serviceName\": \"Full Blood Count\",\n            \"notes\": \"Fasting required this time\"\n        }\n    ],\n    \"nextVisitDays\": 10\n}"
            },
