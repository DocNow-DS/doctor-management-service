{
  "info": {
    "_postman_id": "doctor-management-service",
    "name": "Doctor Management Service API",
    "description": "Complete API collection for Doctor Management Service — Auth, Doctor Profile, Availability, Prescriptions, and Patient Care Plans. Port: 8082.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Authentication for Doctor Management Service. JWT tokens are issued by Patient Management Service (port 8081). Use this redirect endpoint to confirm.",
      "item": [
        {
          "name": "Login Redirect (Doctor)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Doctor Management delegates auth to Patient Management Service. Use http://localhost:8081/api/auth/login to get your JWT token, then paste it into the {{jwtToken}} variable."
          },
          "response": []
        },
        {
          "name": "Login — Patient Management (get JWT here)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.token) {",
                  "        pm.collectionVariables.set('jwtToken', response.token);",
                  "        console.log('JWT token saved to collection variable: jwtToken');",
                  "    }",
                  "    if (response.id) {",
                  "        pm.collectionVariables.set('doctorUserId', response.id);",
                  "        console.log('Doctor user ID saved:', response.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"doctor@example.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "auth", "login"]
            },
            "description": "Login via Patient Management Service. The test script auto-saves the JWT token to {{jwtToken}} collection variable."
          },
          "response": []
        }
      ]
    },
