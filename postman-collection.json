    {
      "name": "Patient Care Plans",
      "description": "After each consultation, the doctor creates a structured care plan for the patient — including medicines (dosage, frequency, duration), allergies, consultation notes, pre-visit lab services, and next visit schedule.",
      "item": [
        {
          "name": "Create Care Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.id) {",
                  "        pm.collectionVariables.set('carePlanId', response.id);",
                  "        console.log('Care Plan ID saved:', response.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"doctorId\": \"{{doctorId}}\",\n    \"patientId\": \"{{patientId}}\",\n    \"appointmentId\": \"{{appointmentId}}\",\n    \"medicines\": [\n        {\n            \"medicineName\": \"Amoxicillin\",\n            \"dosage\": \"500mg\",\n            \"frequency\": \"Twice daily\",\n            \"durationDays\": 7,\n            \"instructions\": \"After meals\"\n        },\n        {\n            \"medicineName\": \"Paracetamol\",\n            \"dosage\": \"500mg\",\n            \"frequency\": \"Every 8 hours if fever\",\n            \"durationDays\": 5,\n            \"instructions\": \"Take with water\"\n        }\n    ],\n    \"allergies\": [\"Penicillin\", \"Aspirin\"],\n    \"consultationNotes\": \"Patient presents with mild fever and sore throat. Diagnosed with URTI. Prescribed antibiotics for 7 days. Review if no improvement.\",\n    \"preVisitServices\": [\n        {\n            \"serviceName\": \"Full Blood Count\",\n            \"notes\": \"Fasting not required\"\n        },\n        {\n            \"serviceName\": \"Urine Analysis\",\n            \"notes\": \"Bring sample in the morning\"\n        }\n    ],\n    \"nextVisitDays\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/care-plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "care-plans"]
            },
            "description": "Create a new patient care plan after a consultation. Status is automatically set to ACTIVE. nextVisitDate is auto-calculated as today + nextVisitDays. The test script saves the returned ID to {{carePlanId}}."
          },
          "response": []
        },
