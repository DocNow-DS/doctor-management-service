{
	"info": {
		"_postman_id": "doctor-management-service",
		"name": "Doctor Management Service - Integrated",
		"description": "Doctor Management Microservice with Patient Service Authentication - Profile management, availability scheduling, and digital prescriptions",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
