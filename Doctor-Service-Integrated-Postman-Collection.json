	"item": [
		{
			"name": "Authentication (Patient Service)",
			"item": [
				{
					"name": "Login - Use Patient Service",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"your-username\",\n    \"password\": \"your-password\"\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login using patient-management-service. Copy the token for doctor service requests."
					},
					"response": []
				},
				{
					"name": "Register Doctor (Doctor Service)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"John\",\n    \"lastName\": \"Smith\",\n    \"email\": \"john.smith@hospital.com\",\n    \"password\": \"password123\",\n    \"phoneNumber\": \"+1234567890\",\n    \"specialization\": \"Cardiology\",\n    \"licenseNumber\": \"MD123456\",\n    \"hospitalName\": \"City General Hospital\",\n    \"yearsOfExperience\": 10,\n    \"education\": \"MD from Harvard Medical School\",\n    \"about\": \"Experienced cardiologist specializing in heart diseases\",\n    \"role\": \"DOCTOR\"\n}"
						},
						"url": {
							"raw": "http://localhost:8082/api/doctors/register",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8082",
							"path": [
								"api",
								"doctors",
								"register"
							]
						},
						"description": "Register doctor profile in doctor service. Use same credentials as patient service for login."
					},
					"response": []
				}
			],
			"description": "Authentication handled by patient-management-service (port 8081). Use the same token for doctor service."
		},
